<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:sweet="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#c10000" />
            <corners android:radius="10.0dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#ff9800" />
            <corners android:radius="10.0dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape>
            <solid android:color="#ff9800" />
            <corners android:radius="10.0dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape>
            <solid android:color="#0f9100" />
            <corners android:radius="10.0dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <solid android:color="#4d0f9100" />
            <corners android:radius="3.0dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#4d0f9100" />
            <corners android:radius="3.0dp" />
        </shape>
    </item>
</selector>
