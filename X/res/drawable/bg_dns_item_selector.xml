<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#57ff17" />
            <stroke android:width="1.5dp" android:color="#5703ff17" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1e2027" />
            <stroke android:width="1.0dp" android:color="#35373d" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
</selector>
