    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/tv_live_preview_banner_cta_unfocused_start" android:endColor="@color/tv_live_preview_banner_cta_unfocused_end" android:angle="270.0" />
            <corners android:radius="100.0dp" />
        </shape>
    </item>
</selector>
