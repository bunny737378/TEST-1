<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/tv_vip_pay_sku_selected_start" android:endColor="@color/tv_vip_pay_sku_selected_end" android:angle="315.0" />
            <corners android:radius="100.0dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:startColor="@color/color_603A21" android:endColor="@color/color_3E2012" android:angle="270.0" />
                    <corners android:radius="100.0dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:startColor="@color/tv_vip_pay_transfer_overlay_start" android:endColor="@color/tv_vip_pay_transfer_overlay_end" android:angle="270.0" />
                    <corners android:radius="100.0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
