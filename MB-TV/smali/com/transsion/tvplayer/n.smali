    d1 = {
        "\u0000\u00f2\u0001\n\u0002\u0018\u0002\n\u0002\u0010\u0000\n\u0002\u0008\u0002\n\u0002\u0010\t\n\u0000\n\u0002\u0018\u0002\n\u0002\u0008\u0004\n\u0002\u0018\u0002\n\u0000\n\u0002\u0010\u000b\n\u0002\u0008\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0018\u0002\n\u0000\n\u0002\u0010\u000e\n\u0000\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0018\u0002\n\u0002\u0008\u0007\n\u0002\u0018\u0002\n\u0002\u0008\u0005\n\u0002\u0018\u0002\n\u0002\u0008\u0005\n\u0002\u0010$\n\u0002\u0008\u0003\n\u0002\u0018\u0002\n\u0000\n\u0002\u0018\u0002\n\u0002\u0008\n\n\u0002\u0018\u0002\n\u0002\u0008\u0006\n\u0002\u0018\u0002\n\u0002\u0008\u000c\n\u0002\u0018\u0002\n\u0002\u0008\u0007\n\u0002\u0010\u0008\n\u0002\u0008\u0002\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0008\r\n\u0002\u0018\u0002\n\u0002\u0008\u0007\n\u0002\u0018\u0002\n\u0002\u0008\u0013\n\u0002\u0010\u0007\n\u0002\u0008\u000e\n\u0002\u0018\u0002\n\u0002\u0008\u0005\n\u0002\u0010 \n\u0002\u0018\u0002\n\u0002\u0008\u0012\n\u0002\u0018\u0002\n\u0002\u0008#\n\u0002\u0010!\n\u0002\u0008\u0005\n\u0002\u0018\u0002\n\u0002\u0008\u0016\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0018\u0002\n\u0002\u0008\u000e\u0008\u00c6\u0002\u0018\u00002\u00020\u0001:\u000c\u00bc\u0001\u00bf\u0001\u00c6\u0001\u00c8\u0001\u00c3\u0001\u0086\u0002B\t\u0008\u0002\u00a2\u0006\u0004\u0008\u0002\u0010\u0003J\u0017\u0010\u0007\u001a\u00020\u00062\u0006\u0010\u0005\u001a\u00020\u0004H\u0002\u00a2\u0006\u0004\u0008\u0007\u0010\u0008J\u000f\u0010\t\u001a\u00020\u0004H\u0002\u00a2\u0006\u0004\u0008\t\u0010\nJ\u000f\u0010\u000c\u001a\u00020\u000bH\u0002\u00a2\u0006\u0004\u0008\u000c\u0010\u0003J\u0017\u0010\u000e\u001a\u00020\r2\u0006\u0010\u0005\u001a\u00020\u0004H\u0002\u00a2\u0006\u0004\u0008\u000e\u0010\u000fJ\u0017\u0010\u0012\u001a\u00020\u000b2\u0006\u0010\u0011\u001a\u00020\u0010H\u0002\u00a2\u0006\u0004\u0008\u0012\u0010\u0013J\'\u0010\u001a\u001a\u00020\u000b2\u0006\u0010\u0015\u001a\u00020\u00142\u0006\u0010\u0017\u001a\u00020\u00162\u0006\u0010\u0019\u001a\u00020\u0018H\u0002\u00a2\u0006\u0004\u0008\u001a\u0010\u001bJ\'\u0010\u001f\u001a\u00020\u000b2\u0006\u0010\u0015\u001a\u00020\u00142\u0006\u0010\u001d\u001a\u00020\u001c2\u0006\u0010\u001e\u001a\u00020\u0016H\u0002\u00a2\u0006\u0004\u0008\u001f\u0010 J\u0017\u0010!\u001a\u00020\u000b2\u0006\u0010\u0017\u001a\u00020\u0016H\u0002\u00a2\u0006\u0004\u0008!\u0010\"J\'\u0010#\u001a\u00020\u000b2\u0006\u0010\u0015\u001a\u00020\u00142\u0006\u0010\u0017\u001a\u00020\u00162\u0006\u0010\u0019\u001a\u00020\u0018H\u0002\u00a2\u0006\u0004\u0008#\u0010\u001bJ\u001f\u0010&\u001a\u00020\r2\u0006\u0010\u0015\u001a\u00020\u00142\u0006\u0010%\u001a\u00020$H\u0002\u00a2\u0006\u0004\u0008&\u0010\'J\'\u0010(\u001a\u00020\u000b2\u0006\u0010\u0015\u001a\u00020\u00142\u0006\u0010%\u001a\u00020$2\u0006\u0010\u001e\u001a\u00020\u0016H\u0002\u00a2\u0006\u0004\u0008(\u0010)J\u0017\u0010,\u001a\u00020\u000b2\u0006\u0010+\u001a\u00020*H\u0002\u00a2\u0006\u0004\u0008,\u0010-J\u0017\u0010.\u001a\u00020\u000b2\u0006\u0010\u0017\u001a\u00020\u0016H\u0002\u00a2\u0006\u0004\u0008.\u0010\"JM\u00102\u001a\u0010\u0012\u0004\u0012\u00020\u0016\u0012\u0006\u0012\u0004\u0018\u00010\u0001002\u0006\u0010\u0017\u001a\u00020\u00162\u0006\u0010\u001d\u001a\u00020\u001c2\u0006\u0010/\u001a\u00020\u00162\u0016\u0008\u0002\u00101\u001a\u0010\u0012\u0004\u0012\u00020\u0016\u0012\u0006\u0012\u0004\u0018\u00010\u000100H\u0002\u00a2\u0006\u0004\u00082\u00103J\u0017\u00107\u001a\u0002062\u0006\u00105\u001a\u000204H\u0002\u00a2\u0006\u0004\u00087\u00108J\u0019\u00109\u001a\u00020\u000b2\u0008\u0010\u0015\u001a\u0004\u0018\u00010\u0014H\u0002\u00a2\u0006\u0004\u00089\u0010:J\u0017\u0010;\u001a\u00020\u000b2\u0006\u0010\u0017\u001a\u00020\u0016H\u0002\u00a2\u0006\u0004\u0008;\u0010\"J\u0017\u0010=\u001a\u00020\u000b2\u0006\u0010<\u001a\u00020\u0016H\u0002\u00a2\u0006\u0004\u0008=\u0010\"J\u0017\u0010>\u001a\u00020\u000b2\u0006\u0010<\u001a\u00020\u0016H\u0002\u00a2\u0006\u0004\u0008>\u0010\"J\u000f\u0010?\u001a\u00020\rH\u0002\u00a2\u0006\u0004\u0008?\u0010@J\u001f\u0010D\u001a\u00020\r2\u0006\u0010B\u001a\u00020A2\u0006\u0010C\u001a\u00020\u0014H\u0002\u00a2\u0006\u0004\u0008D\u0010EJ\u0019\u0010F\u001a\u00020\u00162\u0008\u00105\u001a\u0004\u0018\u000104H\u0002\u00a2\u0006\u0004\u0008F\u0010GJ\u0019\u0010J\u001a\u00020\u00162\u0008\u0010I\u001a\u0004\u0018\u00010HH\u0002\u00a2\u0006\u0004\u0008J\u0010KJ\u0019\u0010L\u001a\u00020\u00162\u0008\u0010I\u001a\u0004\u0018\u00010\u0014H\u0002\u00a2\u0006\u0004\u0008L\u0010MJ\u0015\u0010N\u001a\u00020\u0016*\u0004\u0018\u00010\u0001H\u0002\u00a2\u0006\u0004\u0008N\u0010OJ\u000f\u0010P\u001a\u00020\u0016H\u0002\u00a2\u0006\u0004\u0008P\u0010QJ\u0017\u0010S\u001a\u00020\u00162\u0006\u0010R\u001a\u00020\rH\u0002\u00a2\u0006\u0004\u0008S\u0010TJ\u0019\u0010W\u001a\u00020\u00162\u0008\u0010V\u001a\u0004\u0018\u00010UH\u0002\u00a2\u0006\u0004\u0008W\u0010XJ\u0019\u0010Z\u001a\u00020\u00162\u0008\u0010Y\u001a\u0004\u0018\u00010\u0016H\u0002\u00a2\u0006\u0004\u0008Z\u0010[J\u0017\u0010^\u001a\u00020]2\u0006\u0010\\\u001a\u00020\u0016H\u0002\u00a2\u0006\u0004\u0008^\u0010_J\u0013\u0010b\u001a\u00020a*\u00020`H\u0002\u00a2\u0006\u0004\u0008b\u0010cJ\u0017\u0010d\u001a\u00020\u000b2\u0006\u0010\u0017\u001a\u00020\u0016H\u0002\u00a2\u0006\u0004\u0008d\u0010\"J\u000f\u0010e\u001a\u00020\u000bH\u0002\u00a2\u0006\u0004\u0008e\u0010\u0003J\u0017\u0010g\u001a\u00020\u000b2\u0006\u0010f\u001a\u00020\u0004H\u0002\u00a2\u0006\u0004\u0008g\u0010hJ9\u0010k\u001a\u00020\u000b2\u0006\u0010<\u001a\u00020\u00162\u0016\u0008\u0002\u0010i\u001a\u0010\u0012\u0004\u0012\u00020\u0016\u0012\u0006\u0012\u0004\u0018\u00010\u0001002\u0008\u0008\u0002\u0010j\u001a\u00020\u0016H\u0002\u00a2\u0006\u0004\u0008k\u0010lJ9\u0010m\u001a\u00020\u000b2\u0006\u0010<\u001a\u00020\u00162\u0016\u0008\u0002\u0010i\u001a\u0010\u0012\u0004\u0012\u00020\u0016\u0012\u0006\u0012\u0004\u0018\u00010\u0001002\u0008\u0008\u0002\u0010j\u001a\u00020\u0016H\u0002\u00a2\u0006\u0004\u0008m\u0010lJ9\u0010n\u001a\u00020\u000b2\u0006\u0010<\u001a\u00020\u00162\u0016\u0008\u0002\u0010i\u001a\u0010\u0012\u0004\u0012\u00020\u0016\u0012\u0006\u0012\u0004\u0018\u00010\u0001002\u0008\u0008\u0002\u0010j\u001a\u00020\u0016H\u0002\u00a2\u0006\u0004\u0008n\u0010lJ\u0015\u0010q\u001a\u00020\u000b2\u0006\u0010p\u001a\u00020o\u00a2\u0006\u0004\u0008q\u0010rJ\u0015\u0010s\u001a\u00020\u000b2\u0006\u0010p\u001a\u00020o\u00a2\u0006\u0004\u0008s\u0010rJ\u0015\u0010t\u001a\u00020\u000b2\u0006\u0010p\u001a\u00020o\u00a2\u0006\u0004\u0008t\u0010rJ\r\u0010u\u001a\u000204\u00a2\u0006\u0004\u0008u\u0010vJ\u0015\u0010y\u001a\u00020\u00142\u0006\u0010x\u001a\u00020w\u00a2\u0006\u0004\u0008y\u0010zJ\u0017\u0010{\u001a\u00020\u000b2\u0008\u0008\u0002\u0010\u0017\u001a\u00020\u0016\u00a2\u0006\u0004\u0008{\u0010\"J\r\u0010|\u001a\u00020\u000b\u00a2\u0006\u0004\u0008|\u0010\u0003J\u001d\u0010}\u001a\u00020\u000b2\u0006\u0010x\u001a\u00020w2\u0006\u0010\u0011\u001a\u00020\u0010\u00a2\u0006\u0004\u0008}\u0010~J&\u0010\u007f\u001a\u00020\r2\u0006\u0010x\u001a\u00020w2\u0006\u0010\u0011\u001a\u00020\u00102\u0006\u0010\u0017\u001a\u00020\u0016\u00a2\u0006\u0005\u0008\u007f\u0010\u0080\u0001J\u000f\u0010\u0081\u0001\u001a\u00020\u000b\u00a2\u0006\u0005\u0008\u0081\u0001\u0010\u0003J\u0017\u0010\u0082\u0001\u001a\u00020\u000b2\u0006\u0010\u0011\u001a\u00020\u0010\u00a2\u0006\u0005\u0008\u0082\u0001\u0010\u0013J7\u0010\u0084\u0001\u001a\u00020\r2\u0006\u0010x\u001a\u00020w2\u0006\u0010\u0011\u001a\u00020\u00102\u0008\u0008\u0002\u0010\u0017\u001a\u00020\u00162\u000b\u0008\u0002\u0010\u0083\u0001\u001a\u0004\u0018\u00010\u0018\u00a2\u0006\u0006\u0008\u0084\u0001\u0010\u0085\u0001JL\u0010\u0087\u0001\u001a\u00020\r2\u0006\u0010x\u001a\u00020w2\u0006\u0010\u0011\u001a\u00020\u00102\u0008\u0008\u0002\u0010\u0017\u001a\u00020\u00162\u000b\u0008\u0002\u0010\u0083\u0001\u001a\u0004\u0018\u00010\u00182\t\u0008\u0002\u0010\u0086\u0001\u001a\u00020\r2\u0008\u0008\u0002