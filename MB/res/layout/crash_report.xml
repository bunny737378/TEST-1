<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="#FF000000" android:padding="12.0dp" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
