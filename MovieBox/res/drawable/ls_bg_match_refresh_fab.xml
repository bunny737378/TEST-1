<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ls_matches_fab_background" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:startColor="@color/ls_matches_fab_gradient_start" android:endColor="@color/ls_matches_fab_gradient_end" android:angle="270.0" android:type="linear" />
        </shape>
    </item>
    <item android:left="0.5dp" android:top="0.5dp" android:right="0.5dp" android:bottom="0.5dp">
        <shape android:shape="oval">
            <stroke android:width="1.0dp" android:color="@color/ls_matches_fab_stroke" />
        </shape>
    </item>
</layer-list>
