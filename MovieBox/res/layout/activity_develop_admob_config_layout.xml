<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:padding="16.0dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="14.0sp" android:id="@id/tvTestDeviceIdGuide" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="测试设备 ID 获取步骤：\n1. 使用真机安装并运行 Debug 包。\n2. 进入会请求 AdMob 广告的页面，触发一次 Banner、插屏或激励广告请求。\n3. 在 Android Studio Logcat 搜索 setTestDeviceIds；也可执行：adb logcat | grep -iE &quot;test device|setTestDeviceIds|MobileAds&quot;。\n4. 在 SDK 输出的 setTestDeviceIds(...) 提示中，复制引号内的设备 ID。\n5. 长按下方“AdMob 测试模式”按钮，粘贴并保存设备 ID；随后点击按钮打开测试模式。\n6. Ad Inspector 仅在测试模式打开后使用；点击“打开 AdMob Ad Inspector”会自动开启已配置的测试模式。\n注意：不要填写手机设置中的 Advertising ID / GAID。" android:lineSpacingExtra="4.0dp" android:textIsSelectable="true" />
        <Button android:gravity="start|center" android:id="@id/btnAdMobTestMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16.0dp" android:text="AdMob 测试模式 = false" android:textAllCaps="false" />
        <Button android:id="@id/btnAdInspector" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="打开 AdMob Ad Inspector" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
